views:
  - type: table
    name: Table
    filters:
      and:
        - file.path.startsWith("F26-BSME/MISC/HW")
        - file.name != "HW.base"
        - submitted != "T"
    order:
      - file.name
      - file.tags
      - date
      - submitted
    sort:
      - property: date
        direction: ASC
